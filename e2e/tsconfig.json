{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "module": "node16",
        "moduleResolution": "node16",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "es2025",
        "types": [
            "node"
        ]
    },
    "include": [
        "./**/*.ts",
        "../playwright.config.ts"
    ]
}
